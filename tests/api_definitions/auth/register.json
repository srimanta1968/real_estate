{
  "endpoint": "/api/auth/register",
  "method": "POST",
  "taskId": "0f0cad38-22b4-4788-8ec4-aa23110afa30",
  "requiresAuth": false,
  "description": "User registration endpoint",
  "priority": 1,
  "captureRequest": {
    "auth.register.request.password": "password"
  },
  "captureResponse": {
    "auth.register.response.data.token": "data.token",
    "auth.register.response.data.user.id": "data.user.id",
    "auth.register.response.data.user.email": "data.user.email"
  },
  "testCases": [{
    "name": "Register new user",
    "payload": {
      "email": "{{dynamic:email}}",
      "username": "{{dynamic:username}}",
      "password": "TestPass123!",
      "first_name": "{{dynamic:first_name}}",
      "last_name": "{{dynamic:last_name}}"
    },
    "expectedStatus": 201,
    "expectedResponse": {
      "success": true,
      "data": {
        "token": "{{type:string}}",
        "user": {
          "email": "{{dynamic:email}}"
        }
      }
    }
  }]
}
